{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:4000",
        "DATABASE_URL": "postgresql://build:build@localhost:5432/build"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.orbit.zephyron.tech",
        "DATABASE_URL": "postgresql://build:build@localhost:5432/build"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.orbit.zephyron.tech",
        "DATABASE_URL": "postgresql://build:build@localhost:5432/build"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
