# React Native / Expo's tooling (Metro, autolinking) assumes a flat
# node_modules the way npm/yarn classic produce — pnpm's default symlinked,
# strict node_modules breaks Metro's resolution of several packages' own
# transitive deps (fbjs, @expo/log-box, etc.) that they import without
# declaring as a direct dependency. Hoisting is the documented workaround for
# Expo specifically; the other apps (api, web) are unaffected by it.
node-linker=hoisted
